                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-staff",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staffUsername}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"token presente\", () => pm.expect(data.token).to.exist);",
                  "if (data.token !== undefined) pm.collectionVariables.set(\"staffToken\", data.token);",
                  "pm.test(\"userId presente\", () => pm.expect(data.userId).to.exist);",
