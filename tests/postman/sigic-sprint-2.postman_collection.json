              "bearer": [
                {
                  "key": "token",
                  "value": "{{staffToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"turnoCajaId\": \"{{turnoId}}\",\n  \"desgloseFisico\": [\n    {\n      \"valorUnitario\": 1,\n      \"cantidad\": \"{{efectivoDeclarado}}\"\n    }\n  ],\n  \"totalDigitalDeclarado\": 0,\n  \"justificacion\": \"Ensayo aislado Sprint 2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Convert numeric template fields in raw JSON to numbers before transport.",
          "if (pm.request.body && pm.request.body.mode === \"raw\") {",
          "  const resolved = pm.variables.replaceIn(pm.request.body.raw);",
          "  const body = JSON.parse(resolved);",
          "  function numbers(x) {",
          "    Object.keys(x).forEach(k => { if (x[k] && typeof x[k] === \"object\") numbers(x[k]); else if ([\"precioUnitario\", \"monto\", \"cantidad\"].includes(k) && typeof x[k] === \"string\" && x[k].trim() !== \"\" && Number.isFinite(Number(x[k]))) x[k] = Number(x[k]); });",
          "  }",
          "  numbers(body); pm.request.body.update(JSON.stringify(body));",
          "}"
        ]
      }
    }
  ]
}
