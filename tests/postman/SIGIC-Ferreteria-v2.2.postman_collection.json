{
  "info": {
    "name": "SIGIC Ferretería v2.2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Seleccionar SIGIC Local. Usar una BD descartable, cuentas de Cajero, Tesoreria y ClienteWeb, un producto web con stock en tienda y central, un producto solo POS y una caja sin turno abierto. Completar los valores locales del entorno antes de ejecutar en orden. La venta descuenta una unidad, el cierre declara el fondo de 100 más el cobro y la reserva Yape compromete una unidad."
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login-staff",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{staffUsername}}\",\n  \"password\": \"{{staffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const resultado = pm.response.json();",
                  "pm.test(\"token presente\", () => pm.expect(resultado.token).to.exist);",
                  "if (resultado.token !== undefined) pm.environment.set(\"staffToken\", resultado.token);",
                  "pm.test(\"userId presente\", () => pm.expect(resultado.userId).to.exist);",
                  "if (resultado.userId !== undefined) pm.environment.set(\"staffId\", resultado.userId);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"staffToken\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Login web",
          "request": {
            "method": "POST",
            "header": [
              {
