                  "  pm.expect(datos.estado).not.to.equal(\"requiere_aclaracion\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente web",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/analitica/consultas",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{webToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregunta\": \"Ventas\",\n  \"desde\": \"{{desde}}\",\n  \"hastaExclusivo\": \"{{hastaExclusivo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Anónimo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/analitica/consultas",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pregunta\": \"Ventas\",\n  \"desde\": \"{{desde}}\",\n  \"hastaExclusivo\": \"{{hastaExclusivo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.body && pm.request.body.mode === \"raw\") {",
          "  const numeric = [\"cantidad\", \"precioUnitario\", \"monto\"];",
          "  const body = JSON.parse(pm.request.body.raw, (key, value) => {",
          "    if (typeof value !== \"string\") return value;",
          "    const resolved = pm.variables.replaceIn(value);",
          "    return numeric.includes(key) ? Number(resolved) : resolved;",
          "  });",
          "  pm.request.body.update(JSON.stringify(body));",
          "}"
        ]
      }
    }
  ]
}
